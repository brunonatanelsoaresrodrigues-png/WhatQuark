FROM node:22-alpine AS build

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm install --legacy-peer-deps

COPY . .
ENV NODE_OPTIONS=--max-old-space-size=768
RUN npm run build

FROM nginx:1.27-alpine

ENV PUBLIC_HTML=/usr/share/nginx/html

COPY --from=build /usr/src/app/build /usr/share/nginx/html
COPY .docker/lowmem-nginx.conf /etc/nginx/conf.d/default.conf
COPY .docker/lowmem-env.sh /docker-entrypoint.d/20-whaticket-env.sh

RUN apk add --no-cache jq \
    && chmod +x /docker-entrypoint.d/20-whaticket-env.sh

EXPOSE 80
