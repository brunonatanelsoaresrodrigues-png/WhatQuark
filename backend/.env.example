# WhatsApp Provider Configuration
# Supported providers: wwebjs, whaileys
WHATSAPP_PROVIDER=wwebjs

# Logging (silent, fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
WHAILEYS_LOG_LEVEL=error

# Chrome/Puppeteer Configuration
CHROME_BIN=
CHROME_WS=
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox

# Database
DB_HOST=localhost
DB_DIALECT=mysql
DB_PORT=3306
DB_NAME=whaticket
DB_USER=root
DB_PASS=

# JWT Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Backend URL
BACKEND_URL=http://localhost:8080

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Proxy
PROXY_PORT=8080

# Redis
IO_REDIS_SERVER=127.0.0.1
IO_REDIS_PASSWORD=
IO_REDIS_PORT=6379
IO_REDIS_DB_SESSION=2

# QuarkClinic integration
# Keep disabled until all credentials below have been rotated and configured.
QUARK_INTEGRATION_ENABLED=false
QUARK_API_BASE_URL=https://api.quark.tec.br/clinic/ext
QUARK_AUTH_TOKEN=
QUARK_X_CHAVE_KEY=
QUARK_X_SECRET_KEY=
QUARK_WHATSAPP_ID=
QUARK_POLL_INTERVAL_SECONDS=300
QUARK_STARTUP_DELAY_SECONDS=20
QUARK_REQUEST_TIMEOUT_MS=15000
QUARK_SYNC_HORIZON_DAYS=365
QUARK_TIMEZONE=America/Sao_Paulo
QUARK_DEFAULT_COUNTRY_CODE=55
QUARK_CLINIC_ADDRESS=
QUARK_REMINDER_HOURS=24
QUARK_SEND_INTERVAL_MIN_SECONDS=15
QUARK_SEND_INTERVAL_MAX_SECONDS=45
QUARK_MAX_MESSAGES_PER_HOUR=100
QUARK_QUIET_HOURS_START=20:00
QUARK_QUIET_HOURS_END=08:00
QUARK_MAX_RETRY_ATTEMPTS=5
QUARK_PROCESSING_TIMEOUT_MINUTES=10
QUARK_WORKER_POLL_INTERVAL_SECONDS=5
QUARK_DRY_RUN=true
QUARK_TEST_ALLOWLIST=
QUARK_CANCEL_REASON=Cancelado pelo paciente atraves da confirmacao no WhatsApp

# ENCERRAMENTO POR INATIVIDADE DO PACIENTE
TICKET_INACTIVITY_ENABLED=false
TICKET_INACTIVITY_TIMEOUT_MINUTES=15
TICKET_INACTIVITY_POLL_INTERVAL_SECONDS=30
TICKET_INACTIVITY_CLAIM_TIMEOUT_MINUTES=5
TICKET_INACTIVITY_SEND_INTERVAL_MIN_SECONDS=15
TICKET_INACTIVITY_SEND_INTERVAL_MAX_SECONDS=45

# MENSAGERIA SEGURA — sem envios ate concluir docs/messaging-safety-rollout.md
MESSAGING_MODE=simulation
MESSAGING_TEST_ALLOWLIST=
MESSAGING_MAX_PER_HOUR=100
MESSAGING_MIN_INTERVAL_SECONDS=2
MESSAGING_MAX_NOTICES_PER_DAY=3
BOT_FALLBACK_QUEUE_ID=
# Opcional: somente se uma migração para Cloud API for solicitada.
CLOUD_WHATSAPP_ID=
CLOUD_PHONE_NUMBER_ID=
CLOUD_API_VERSION=
CLOUD_ACCESS_TOKEN=
CLOUD_APP_SECRET=
CLOUD_VERIFY_TOKEN=
CLOUD_QUARK_APPOINTMENT_TEMPLATE=
CLOUD_QUARK_CANCELLED_TEMPLATE=
CLOUD_TEMPLATE_LANGUAGE=pt_BR
