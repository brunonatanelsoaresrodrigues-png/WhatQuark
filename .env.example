# MYSQL
MYSQL_ENGINE=
MYSQL_VERSION=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=whaticket
MYSQL_PORT=
TZ=

# BACKEND
BACKEND_PORT=
BACKEND_SERVER_NAME=api.mydomain.com
BACKEND_URL=https://api.mydomain.com
PROXY_PORT=443
JWT_SECRET=
JWT_REFRESH_SECRET=

# QUARKCLINIC (mantenha desativado ate preencher novas credenciais)
QUARK_INTEGRATION_ENABLED=false
PATIENT_INTAKE_QUARK_BOOKING_ENABLED=true
QUARK_API_BASE_URL=https://api.quark.tec.br/clinic/ext
QUARK_AUTH_TOKEN=
QUARK_X_CHAVE_KEY=
QUARK_X_SECRET_KEY=
QUARK_WHATSAPP_ID=
QUARK_POLL_INTERVAL_SECONDS=300
QUARK_STARTUP_DELAY_SECONDS=20
QUARK_REQUEST_TIMEOUT_MS=15000
QUARK_SYNC_HORIZON_DAYS=365
QUARK_TIMEZONE=America/Sao_Paulo
QUARK_DEFAULT_COUNTRY_CODE=55
QUARK_CLINIC_ADDRESS=
QUARK_REMINDER_HOURS=24,2
QUARK_SEND_INTERVAL_MIN_SECONDS=15
QUARK_SEND_INTERVAL_MAX_SECONDS=45
QUARK_MAX_MESSAGES_PER_HOUR=100
QUARK_QUIET_HOURS_START=20:00
QUARK_QUIET_HOURS_END=08:00
QUARK_MAX_RETRY_ATTEMPTS=5
QUARK_PROCESSING_TIMEOUT_MINUTES=10
QUARK_WORKER_POLL_INTERVAL_SECONDS=5
QUARK_DRY_RUN=true
QUARK_TEST_ALLOWLIST=
QUARK_CANCEL_REASON=Cancelado pelo paciente atraves da confirmacao no WhatsApp
# false: avisos operacionais de consultas existentes não exigem registro manual.
# PARAR/SAIR/STOP continua bloqueando todos os avisos para o número.
QUARK_APPOINTMENT_NOTICES_REQUIRE_OPT_IN=false

# ENCERRAMENTO POR INATIVIDADE DO PACIENTE
TICKET_INACTIVITY_ENABLED=false
TICKET_INACTIVITY_TIMEOUT_MINUTES=15
TICKET_INACTIVITY_POLL_INTERVAL_SECONDS=30
TICKET_INACTIVITY_CLAIM_TIMEOUT_MINUTES=5
TICKET_INACTIVITY_SEND_INTERVAL_MIN_SECONDS=15
TICKET_INACTIVITY_SEND_INTERVAL_MAX_SECONDS=45

# FECHAMENTO GERENCIAL DIARIO (configure o ID do canal conectado)
DAILY_REPORT_ENABLED=false
DAILY_REPORT_TEST_MODE=true
DAILY_REPORT_TIME=17:00
DAILY_REPORT_TIMEZONE=America/Sao_Paulo
DAILY_REPORT_WHATSAPP_ID=
DAILY_REPORT_POLL_INTERVAL_SECONDS=30
DAILY_REPORT_SEND_INTERVAL_SECONDS=20
DAILY_REPORT_MAX_RETRY_ATTEMPTS=5
DAILY_REPORT_ALLOW_WEEKENDS=true

# FRONTEND
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443
FRONTEND_SERVER_NAME=myapp.mydomain.com
FRONTEND_URL=https://myapp.mydomain.com

# BROWSERLESS
MAX_CONCURRENT_SESSIONS=

# PHPMYADMIN
PMA_PORT=

# MENSAGERIA SEGURA — sem envios ate concluir docs/messaging-safety-rollout.md
WHATSAPP_PROVIDER=whaileys
WHATSAPP_CONNECTIONS_ENABLED=true
# Set false to wait for manual connection after a backend restart.
WHATSAPP_AUTO_START=true
MESSAGING_MODE=simulation
MESSAGING_TEST_ALLOWLIST=
MESSAGING_MAX_PER_HOUR=30
MESSAGING_MAX_AUTOMATED_PER_DAY=400
MESSAGING_MIN_INTERVAL_SECONDS=4
MESSAGING_INTERACTIVE_MIN_INTERVAL_SECONDS=4
MESSAGING_INTERACTIVE_JITTER_SECONDS=4
MESSAGING_AUTOMATED_MIN_INTERVAL_SECONDS=45
MESSAGING_AUTOMATED_JITTER_SECONDS=45
MESSAGING_MAX_NOTICES_PER_DAY=3
BOT_FALLBACK_QUEUE_ID=
DASHBOARD_SLA_MINUTES=5
# Opcional: somente se uma migração para Cloud API for solicitada.
CLOUD_WHATSAPP_ID=
CLOUD_PHONE_NUMBER_ID=
CLOUD_API_VERSION=
CLOUD_ACCESS_TOKEN=
CLOUD_APP_SECRET=
CLOUD_VERIFY_TOKEN=
CLOUD_QUARK_APPOINTMENT_TEMPLATE=
CLOUD_QUARK_CANCELLED_TEMPLATE=
CLOUD_TEMPLATE_LANGUAGE=pt_BR
